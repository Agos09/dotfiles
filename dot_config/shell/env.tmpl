# PATH settings
export PATH="/usr/local/bin:/usr/bin:/bin:/snap/bin:$HOME/.emacs.d/bin:$PATH"

# App Settings
{{- if eq .distro "arch" }}
export LEDGER_FILE=~/hledger_data/master.journal
{{- end }}
export NVM_DIR="$HOME/.nvm"
export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'
export LS_COLORS=$LS_COLORS:'ow=01;34:'
export EDITOR=nvim
